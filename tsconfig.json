{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],

    /* Strictness: catch mistakes at compile time rather than in a flaky test run. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],

    /* Path aliases make the layer a file belongs to obvious at the import site. */
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["ui/*"],
      "@api/*": ["api/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "ui/**/*.ts",
    "api/**/*.ts",
    "shared/**/*.ts",
    "playwright.config.ts",
    "auth.setup.ts"
  ],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
