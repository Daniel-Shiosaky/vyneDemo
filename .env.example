# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# In CI these come from GitHub repository secrets, never from a committed file.
#
# `shared/const/env.const.ts` is the only module that reads these - specs, page objects and
# API utilities all import ENV from there.

# ---- Applications under test ----
WEB_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# ---- SauceDemo credentials ----
# One shared password for every account. Copy it from the "Password for all users" panel on
# the SauceDemo login page. Deliberately left blank here so no credential is committed.
PASSWORD=

# The account every authenticated journey uses.
USERNAME=standard_user

# Used by the login journey to assert that a blocked account is refused.
LOCKED_OUT_USERNAME=locked_out_user

# ---- Optional ----
# Set to 1 to log every API request and its response status.
# API_DEBUG=1
