{
  "name": "vyne-demo-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript test automation framework for SauceDemo (UI) and JSONPlaceholder (API), using the Page Object Model.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:ui:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "zod": "^4.1.13"
  }
}
